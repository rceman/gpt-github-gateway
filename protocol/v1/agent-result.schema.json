{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rceman/gpt-github-gateway/protocol/v1/agent-result.schema.json",
  "title": "GPT GitHub Gateway Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "gates",
    "deviations",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"},
    "status": {"enum": ["succeeded", "failed", "needs_gpt_revision"]},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "evidence_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "exit", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skipped"]},
          "exit": {"type": "integer"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "summary",
          "workaround",
          "scope_changed",
          "behavior_changed",
          "requirements"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "workaround": {"type": "string", "minLength": 1},
          "scope_changed": {"type": "boolean"},
          "behavior_changed": {"const": false},
          "requirements": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"required": ["implementation_commit", "evidence_commit"]}
    }
  ]
}
