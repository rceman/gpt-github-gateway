{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway Agent Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "details",
    "gates",
    "deviations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "needs_gpt_revision",
        "failed"
      ]
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "details": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "gates": {
      "type": "array",
      "maxItems": 128
    },
    "deviations": {
      "type": "array",
      "maxItems": 64
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "required": [
          "implementation_commit",
          "evidence_commit"
        ],
        "properties": {
          "gates": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_gpt_revision"
          }
        }
      },
      "then": {
        "required": [
          "next_action"
        ]
      }
    }
  ]
}
