{
  "schema_version": 2,
  "gateway": {
    "id": "home_pc",
    "poll_interval_seconds": 10,
    "agent_timeout_seconds": 7200,
    "allow_patch_repair": true,
    "task_execution_mode": "auto"
  },
  "bus": {
    "repository": "rceman/typer",
    "url": "git@github.com:rceman/typer.git",
    "template_branch": "main",
    "control_branch_pattern": "gateway/{gateway_id}",
    "project_branch_pattern": "project/{gateway_id}/{project_id}",
    "heartbeat_interval_seconds": 600,
    "lease_duration_seconds": 1500
  },
  "server": {
    "listen": "127.0.0.1:8787"
  },
  "airelay": {
    "binary": "airelay"
  },
  "projects": {
    "gpt-github-gateway": {
      "path": "/home/therceman/.gpt-github-gateway/sources/gpt-github-gateway",
      "repository": "rceman/gpt-github-gateway",
      "default_branch": "main",
      "airelay_profile": "codex",
      "session_key": "gpt-github-gateway_master",
      "resume_session_id": "LOCAL_CODEX_SESSION_ID",
      "launch_args": [
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    }
  }
}
